{
  "name": "komorebi-shrine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc -b && vite build && node scripts/build-server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/index.mjs",
    "stats": "node --import tsx scripts/visitor-report.mjs",
    "db:check": "node --import tsx scripts/db-check.mjs",
    "db:setup": "node --import tsx scripts/db-migrate.mjs",
    "db:import": "node --import tsx scripts/db-import.mjs",
    "admin:setup": "node scripts/admin-setup.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "three": "^0.180.0",
    "vue": "^3.5.22",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.1.1"
  }
}
