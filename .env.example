# Vite loads this value when building a separately hosted frontend.
# VITE_REALTIME_URL=wss://realtime.example.com/realtime

# Server environment (.env is loaded by the game server; hosting settings also work).
# PORT=8787
# HOST=0.0.0.0
# ALLOWED_ORIGINS=https://shrine.example.com
# Private persistent directory for lanterns.json AND visitors.json.
# DATA_DIR=./data
# free: all currently available lanterns can be hung without payment.
# paid: stop ALL free issuance; paid checkout is not implemented yet.
# LANTERN_MODE=free

# Optional server-only administrator password (14–256 characters).
# Without it, private DATA_DIR/admin.json is used; create it with npm run admin:setup.
# ADMIN_PASSWORD=

# file (default) or supabase. Explicit opt-in; no automatic import or fallback.
# STORAGE_BACKEND=supabase
# Server only. Existing NEXT_PUBLIC_SUPABASE_URL is also accepted for the URL.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
# Legacy server key is supported instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=
# No browser Supabase key is needed: the browser talks to our game server.
# SUPABASE_ACCESS_TOKEN is only needed for db:setup if the CLI is not logged in.
